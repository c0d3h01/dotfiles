{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "",
  "small_model": "",
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
    },
    "edit": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git rebase*": "ask",
      "git checkout -- *": "ask",
      "chmod -R*": "ask",
      "chown -R*": "ask",
      "dd *": "deny",
      "mkfs*": "deny",
      "diskutil erase*": "deny",
      "sh": "ask",
      "bash": "ask",
      "zsh": "ask",
      "*drop database*": "ask",
      "*truncate*": "ask",
    },
  },
  "plugin": ["@dietrichgebert/ponytail"],
  "default_agent": "build",
  "formatter": true,
  "lsp": true,
  "autoupdate": false,
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true,
  },
  "tools": {
    "context7*": false,
    "websearch*": false
  },
  "mcp": {
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": false,
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "oauth": false,
      "enabled": true,
    },
    "rea": {
      "type": "local",
      "command": ["rea", "mcp"],
      "enabled": false,
    },
    "caveman": {
      "type": "local",
      "command": ["/Users/harshal/.caveman/bin/caveman-mcp"],
      "enabled": true,
    },
    "skill-issue": {
      "type": "remote",
      "url": "https://skill-issue.in/api/mcp",
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
    },
  },
}
