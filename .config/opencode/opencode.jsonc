{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "bash": {
      "rm -rf *": "ask",
      "sudo *": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "*drop database*": "ask",
      "*truncate*": "ask"
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "default_agent": "build",
  "formatter": true,
  "lsp": true,
  "autoupdate": false,
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": false
    },
    "shopify": {
      "type": "remote",
      "url": "https://setup.shopify.com/mcp",
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@microsoft/postgres-mcp",
        "run"
      ],
      "enabled": false
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "oauth": false,
      "enabled": false
    },
    "wpvibe": {
      "type": "remote",
      "url": "https://mcp.wpvibe.ai/mcp",
      "enabled": false
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ],
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "oauth": false,
      "enabled": true
    },
    "rea": {
      "type": "local",
      "command": [
        "rea",
        "mcp"
      ],
      "enabled": false
    },
    "caveman": {
      "type": "local",
      "command": [
        "/Users/harshal/.caveman/bin/caveman-mcp"
      ],
      "enabled": true
    },
    "servers": {
      "skill-issue": {
        "type": "remote",
        "url": "https://skill-issue.in/api/mcp"
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ]
      }
    }
  }
}
