Include ~/.orbstack/ssh/config
# mac-only. stow this repo, then: mkdir -p ~/.ssh/sockets && chmod 700 ~/.ssh && chmod 600 ~/.ssh/config
# 1Password agent: uncomment if installed, else ssh falls back to macOS keychain.
Host *
  AddKeysToAgent yes
  UseKeychain yes
  # IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  ServerAliveInterval 60
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 10m
  HashKnownHosts yes
  IdentitiesOnly no

Host github.com
  HostName github.com
  User git
