Include ~/.orbstack/ssh/config
# mac-only. stow this repo, then: mkdir -p ~/.ssh/sockets && chmod 700 ~/.ssh && chmod 600 ~/.ssh/config
Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 10m
  HashKnownHosts yes
  IdentitiesOnly no

Host github.com
  HostName github.com
  User git
